// MarrowNode Prisma Schema
// Connects to Neon PostgreSQL with pooled connection for runtime and direct connection for migrations

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["marrownode"]
}

enum AnalysisStatus {
  PENDING
  QUEUED
  RUNNING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLED

  @@schema("marrownode")
}

// -------------------------------------------------------------
// USER / PROFILE MODEL
// Anchored by supabaseUserId to the authenticated Supabase user
// -------------------------------------------------------------
model User {
  id               String            @id @default(cuid())
  supabaseUserId   String            @unique
  email            String            @unique
  displayName      String?
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  githubConnection GitHubConnection?
  projects         Project[]

  @@map("users")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// GITHUB CONNECTION MODEL
// Stores non-sensitive GitHub profile metadata for the user
// -------------------------------------------------------------
model GitHubConnection {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubAccountId  String
  githubUsername   String
  avatarUrl        String?
  accessToken      String?
  connectionStatus String   @default("connected")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("github_connections")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// PROJECT MODEL
// Represents an indexed developer codebase workspace
// -------------------------------------------------------------
model Project {
  id                   String         @id @default(cuid())
  ownerId              String
  owner                User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  githubRepositoryId   String?
  githubRepositoryName String?
  githubOwner          String?
  defaultBranch        String         @default("main")
  visibility           String         @default("private")
  primaryLanguage      String?
  framework            String?
  database             String?
  isActive             Boolean        @default(true)
  analysisStatus       AnalysisStatus @default(PENDING)
  lastAnalyzedAt       DateTime?
  prChecksEnabled      Boolean        @default(false)
  prCheckAutoPublish   Boolean        @default(false)
  prWebhookSecretEnc   String?
  prWebhookSecretLast4 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  repository           Repository?
  analyses             Analysis[]
  evidences            Evidence[]
  pullRequestChecks    PullRequestCheck[]
  commits              ProjectCommit[]

  @@index([ownerId])
  @@index([ownerId, isActive])
  @@map("projects")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// REPOSITORY MODEL
// Metadata about the linked GitHub repository
// -------------------------------------------------------------
model Repository {
  id               String    @id @default(cuid())
  projectId        String    @unique
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubRepoId     String?
  owner            String
  name             String
  fullName         String
  url              String
  defaultBranch    String    @default("main")
  currentCommitSha String?
  isPrivate        Boolean   @default(true)
  language         String?
  description      String?
  stars            Int       @default(0)
  isFork           Boolean   @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pullRequestChecks PullRequestCheck[]
  commits           ProjectCommit[]
  astCaches         AstFileCache[]

  @@map("repositories")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// ANALYSIS MODEL
// Historical analysis runs and status checkpoints
// -------------------------------------------------------------
model Analysis {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId         String?
  status               AnalysisStatus @default(PENDING)
  commitSha            String?
  branch               String?
  coverage             Float?
  analyzerVersion      String?        @default("v3.0")
  startedAt            DateTime?
  completedAt          DateTime?
  filesAnalyzed        Int            @default(0)
  commitsAnalyzed      Int            @default(0)
  dependenciesDetected Int            @default(0)
  architectureNodes    Int            @default(0)
  evidenceCount        Int            @default(0)
  totalFiles           Int            @default(0)
  processedFiles       Int            @default(0)
  failedFiles          Int            @default(0)
  ignoredFiles         Int            @default(0)
  totalSourceFiles     Int            @default(0)
  processedSourceFiles Int            @default(0)
  totalBatches         Int            @default(0)
  completedBatches     Int            @default(0)
  currentBatch         Int            @default(0)
  historyStatus        String         @default("PENDING")
  totalCommitsIngested Int            @default(0)
  historyNextPage      Int            @default(1)
  failedFilesJson      Json?
  errorMessage         String?
  summaryJson          Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  pullRequestChecks    PullRequestCheck[]
  batches              AnalysisBatch[]

  @@index([projectId])
  @@index([projectId, createdAt])
  @@map("analyses")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// EVIDENCE MODEL
// Evidence-backed intelligence for software context & decisions
// -------------------------------------------------------------
model Evidence {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // files, commits, pull_requests, documentation, dependencies, architecture
  title       String
  path        String?
  externalUrl String?
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([projectId, type])
  @@map("evidences")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// PULL REQUEST CHECK MODELS
// Evidence-backed GitHub PR impact checks & audit history
// -------------------------------------------------------------
enum PrCheckStatus {
  PASS
  REVIEW
  INCOMPLETE

  @@schema("marrownode")
}

model PullRequestCheck {
  id                      String        @id @default(cuid())
  projectId               String
  project                 Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId            String
  repository              Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisId              String?
  analysis                Analysis?     @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  prNumber                Int
  prTitle                 String
  prUrl                   String?
  prState                 String        @default("open")
  authorLogin             String?
  baseBranch              String?
  headBranch              String?
  baseSha                 String
  headSha                 String
  analyzedCommitSha       String?
  status                  PrCheckStatus @default(REVIEW)
  impactLevel             String        @default("ISOLATED")
  changedFilesCount       Int           @default(0)
  directAffectedCount     Int           @default(0)
  transitiveAffectedCount Int           @default(0)
  isPartialAnalysis       Boolean       @default(false)
  isStaleBase             Boolean       @default(false)
  summaryText             String
  triggerSource           String        @default("manual")
  githubPublishStatus     String?
  githubPublishNote       String?
  reportJson              Json
  checkedAt               DateTime      @default(now())
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([repositoryId, prNumber, headSha])
  @@index([projectId, createdAt])
  @@index([projectId, prNumber])
  @@index([repositoryId, prNumber])
  @@map("pull_request_checks")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// SCALABLE BATCH ANALYSIS & INCREMENTAL AST CACHE
// Resumable AST batches + blob-SHA keyed AST reuse
// -------------------------------------------------------------
model AnalysisBatch {
  id                  String   @id @default(cuid())
  analysisId          String
  analysis            Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  projectId           String
  batchNumber         Int
  status              String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  fileCount           Int      @default(0)
  processedCount      Int      @default(0)
  failedCount         Int      @default(0)
  locTotal            Int      @default(0)
  fileManifestJson    Json?    // Array<{ path, sha? }>
  parsedFilesJson     Json?    // Array<{ filePath, loc, imports, exports }>
  failedFilesJson     Json?    // Array<{ path, reason, stage }>
  startedAt           DateTime?
  completedAt         DateTime?
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([analysisId, batchNumber])
  @@index([analysisId, status])
  @@index([projectId])
  @@map("analysis_batches")
  @@schema("marrownode")
}

model AstFileCache {
  id              String     @id @default(cuid())
  repositoryId    String
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  filePath        String
  blobSha         String
  analyzerVersion String     @default("v3.0")
  loc             Int        @default(0)
  parsedAstJson   Json
  createdAt       DateTime   @default(now())

  @@unique([repositoryId, filePath, blobSha, analyzerVersion])
  @@index([repositoryId, analyzerVersion])
  @@map("ast_file_cache")
  @@schema("marrownode")
}

// -------------------------------------------------------------
// PAGINATED GIT COMMIT HISTORY
// Incremental, deduplicated commit persistence keyed by commit SHA
// -------------------------------------------------------------
model ProjectCommit {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  commitSha    String
  shortSha     String
  branch       String     @default("main")
  message      String
  body         String?
  eventType    String     @default("feature")
  authorName   String     @default("Developer")
  authorEmail  String?
  committedAt  DateTime
  createdAt    DateTime   @default(now())

  @@unique([repositoryId, commitSha])
  @@index([projectId, committedAt])
  @@index([projectId, branch, committedAt])
  @@map("project_commits")
  @@schema("marrownode")
}
